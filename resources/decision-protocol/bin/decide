# decide inside sessions Signoff AI starts.
# - The app sets both variables when it spawns claude.
# - DECISION_IDE_NODE is the app's own binary, run as plain Node.
: "${DECISION_IDE_CLI:?decide: DECISION_IDE_CLI is not set (start this session from Signoff AI)}"
: "${DECISION_IDE_NODE:?decide: DECISION_IDE_NODE is not set (start this session from Signoff AI)}"
ELECTRON_RUN_AS_NODE=1 exec "$DECISION_IDE_NODE" "$DECISION_IDE_CLI" "$@"
