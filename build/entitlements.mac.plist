<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions Signoff AI needs, and nothing more:
     - allow-jit, allow-unsigned-executable-memory: V8, Electron's JavaScript engine, compiles code at run time.
     - disable-library-validation: the app is ad-hoc signed (no Apple team id), so its own native modules
       (better-sqlite3, node-pty) would otherwise be refused. Drop it once a Developer ID signs the app.
     Removed: allow-dyld-environment-variables (allowed injecting libraries through DYLD_* variables). -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
